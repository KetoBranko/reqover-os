# ProRendo OS – Umgebungsvariablen
# Kopiere diese Datei nach .env.local und trage die Werte ein.
# .env.local wird nie committet. Keine echten Schlüssel in diese Datei schreiben.

# development | test | production
APP_ENV=development

# --- Supabase -------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# "anon" / "publishable" Key (darf im Browser stehen, RLS schützt die Daten)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUR für Admin-Skripte (Benutzer anlegen). Niemals im Browser, nie im Request-Pfad.
SUPABASE_SERVICE_ROLE_KEY=

# --- Datenbank -------------------------------------------------------------
# Verbindung des Next.js-Servers. Supabase: Connect → Transaction pooler (Port 6543).
# Der Server setzt pro Transaktion die Rolle "authenticated", RLS bleibt aktiv.
DATABASE_URL=
# Verbindung für Migrationen (Session pooler oder direkte Verbindung, Port 5432)
MIGRATION_DATABASE_URL=
# Alternative for hosted deployments (Vercel): only the database password plus
# the pooler host; both URLs above are then built from these and the project URL.
# SUPABASE_DB_PASSWORD=
# SUPABASE_POOLER_HOST=aws-1-eu-central-1.pooler.supabase.com

# --- AI (optional, ohne Schlüssel laufen alle Workflows manuell) ----------
# anthropic | none
AI_PROVIDER=none
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Alternative name, e.g. where the platform withholds ANTHROPIC_API_KEY:
# PRORENDO_ANTHROPIC_API_KEY=  (old name REQOVER_ANTHROPIC_API_KEY still works)
AI_MODEL_EXTRACTION=claude-sonnet-5-5
AI_MODEL_ASSISTANT=claude-sonnet-5-5

# --- Transkription (optional) ---------------------------------------------
# browser (Spracherkennung des Browsers) | openai (Server-Transkription) | none
STT_PROVIDER=browser
# platform.openai.com → API keys
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe

# --- Nur lokale Entwicklung ------------------------------------------------
# Wird von scripts/local-setup.mjs erzeugt
LOCAL_JWT_SECRET=

# --- Kontaktformular der Landingpage (optional) ----------------------------
# Organisation, die Anfragen von prorendo.de erhält. Leer = die einzige vorhandene.
LEAD_ORGANIZATION_ID=
# Erlaubte Absender-Domains, kommagetrennt. Leer = https://prorendo.de,https://www.prorendo.de
LEAD_ALLOWED_ORIGINS=
